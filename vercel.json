{
  "crons": [
    {
      "path": "/api/cron/subscribe-youtube",
      "schedule": "0 0 * * *"
    }
  ],
  "functions": {
    "api/**/*.js": {
      "maxDuration": 10
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/(.*)",
      "status": 404
    }
  ]
}
